@InBook{	  doi:10.1002/9781119721611.ch10,
  title		= {How to Model the Covariance Structure in a Spatial
		  Framework: Variogram or Correlation Function?},
  author	= {Pistone, Giovanni and Vicario, Grazia},
  year		= {2020},
  booktitle	= {Data Analysis and Applications 4},
  publisher	= {John Wiley \& Sons, Ltd},
  pages		= {167--183},
  doi		= {10.1002/9781119721611.ch10},
  isbn		= {9781119721611},
  url		= {https://onlinelibrary.wiley.com/doi/abs/10.1002/9781119721611.ch10},
  chapter	= {10},
  eprint	= {https://onlinelibrary.wiley.com/doi/pdf/10.1002/9781119721611.ch10},
  keywords	= {correlation matrix, Gaussian field, geostatistics,
		  Matheron's variogram function, Universal Kriging model,
		  variogram matrix},
  abstract	= {Summary This chapter discusses in detail the option to
		  actually use the variogram as a parameterization. The
		  notion of a variogram as it is used in geostatistics is
		  also discussed. The chapter offers some preliminary thought
		  about the possibility of a non-parametric approach to
		  Universal Kriging that aims to use the Bayes methodology.
		  It provides a brief overview of Universal Kriging model and
		  its parameterization with the Matheron's variogram
		  function. The chapter defines the general variogram matrix
		  and provides a necessary and sufficient condition for a
		  positive variance and a matrix to be a variogram matrix of
		  a covariance. The chapter also provides some useful
		  computations concerning the inverse variogram matrix. It
		  also discusses an interpretation of the variogram matrix as
		  related to a projection of the Gaussian field. The chapter
		  describes the shape of the set of parameters of the general
		  Kriging model.}
}

