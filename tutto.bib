@Article{	  amari:87invert,
  title		= {Differential geometry of a parametric family of invertible
		  linear systems---{R}iemannian metric, dual affine
		  connections, and divergence},
  author	= {Amari, Shu{n-i}chi},
  year		= {1987},
  journal	= {Mathematical Systems Theory},
  volume	= {20},
  number	= {1},
  pages		= {53--82},
  ams		= {62M10, 53C05, 62M15},
  mathrev	= {This paper deals with scalar Gaussian stationary processes
		  with absolutely continuous spectra and continuous spectral
		  densities, $S(\omega)$, $0<S(\omega)<\infty$,
		  $\omega\in[-\pi,\pi]$. The classes considered are $L$, for
		  which $\max\sb \omega\vert \log S(\omega\vert <\infty$, and
		  $L\sb 0$, for which $\int\{\log S(\omega)\}\sp
		  2d\omega<\infty$. Certain special subsets are introduced
		  based on the quantities $R\sp {(\alpha)}(\omega)$, defined
		  to be $-\alpha\sp {-1}S(\omega)\sp {-\alpha}$ for
		  $\alpha\not=0$ and $\log S(\omega)$ for $\alpha=0$. Putting
		  $e\sb t(\omega) =2\sp {1/2}\cos t\omega$, then $c\sp
		  {(\alpha)}\sb t=(2\pi)\sp {-1}\int R\sp
		  {(\alpha)}(\omega)e\sb t(\omega)d\omega$ are used as
		  coordinates in $L\sb \alpha$ which is, presumably, the
		  subset for which $\sum\sp \infty\sb 0 c\sp {(\alpha)}\sb
		  te\sb t(\omega)$ represents the formal Fourier series for
		  $R\sp {(\alpha)}(\omega)$. Let $M\sp {(\alpha)}\sb p$ be
		  the subset of $L\sb \alpha$ for which only $p$ of the $c\sp
		  {(\alpha)}\sb t$ are nonnull. The idea is to incorporate
		  into the theory a range of previously considered cases; for
		  example, $\alpha=-1$ corresponds to autoregressions. A
		  ``natural'' affine connection is introduced into $M\sp
		  {(\alpha)}\sb p$. In particular, this may be effected
		  uniquely by introducing a metric tensor defining an inner
		  product in the tangent space and requiring the affine
		  connection to be torsion-free and such that parallel
		  displacement preserves the inner product. The connection is
		  then a Riemannian connection. An affine connection is
		  introduced in $M\sp {(\alpha)}\sb p$ for each $\alpha$ and
		  $L\sb \alpha$ is shown to be flat in the sense that the
		  curvature and torsion tensors vanish. In case $\alpha=0$
		  the connection can be considered a Riemannian connection
		  with the metric tensor corresponding to the Fisher
		  information. A duality theory is established between the
		  cases $\alpha$, $-\alpha$ (related to that between moving
		  averages and autoregressions). A notion of divergence or
		  directed distance between points in $L\sb \alpha$ is
		  established for all $\alpha$ and this is to be used to
		  define approximation, convergence and so on. The paper concludes with a brief discussion of some special topics such as Lie group structure}
}

