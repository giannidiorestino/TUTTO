@article{fujiwara|amari:1995grad,
  title         = {Gradient systems in view of information geometry},
  author        = {Fujiwara, Akio and Amari, Shu{n-i}chi},
  year          = {1995},
  journal       = {Physica D. Nonlinear Phenomena},
  volume        = {80},
  number        = {3},
  pages         = {317--327},
  ams           = {53B05, 62A10, 90C05, 92B20},
  mathrev       = {The authors investigate properties of a gradient flow on a manifold $M$ with a dualistic structure $(g, \nabla, \nabla\sp *)$. A dualistic structure $(g, \nabla, \nabla\sp *)$ consists of a Riemannian metric, a connection $\nabla$ and a dual connection $\nabla\sp *$ such that $dg(X, Y) = g(\nabla X, Y) + g( X, \nabla\sp *Y)$ for any vector fields $X$ and $Y$. In the case of interest to the authors they require that $\nabla$ and $\nabla\sp *$ have vanishing torsion and curvature. Note that this does not mean that $M$ is flat as a Riemannian manifold as $\nabla$ is generally not the Levi-Civita connection. For such manifolds there are interesting gradient flows. The authors consider a number of examples: maximum likelihood estimation, Boltzmann machines and EM algorithms, linear programming and the replicator equation in mathematical biology}
}

@article{fujiwara|amari:1995info,
  title         = {Information geometry and dynamical systems},
  author        = {Fujiwara, Akio and Amari, Shu{n-i}chi},
  year          = {1995},
  journal       = {Systems, Control and Information. Shisutemu, Seigyo, Joho},
  volume        = {39},
  number        = {1},
  pages         = {14--21},
  ams           = {53B99},
  mathrev       = {This is an expository article on a survey of the applications of information geometry to the theory of dynamical systems. Beginning with the definitions of dual connections, dually flat Riemannian manifolds $M(g,\nabla,\nabla\sp *)$ and the induced divergence on the manifolds, the authors first give a gradient flow on a dually flat manifold, whose $\nabla\sp *$-geodesic converges to a preassigned point by making use of the $\nabla$-divergence. The authors next consider the $\nabla$-self-parallel submanifold and give its applications to the Boltzmann machines and the EM-algorithm as well as linear programming problems. At the end of the article the authors enumerate a number of interesting problems in the field of technology, awaiting the applications of the theory of information geometry}
}

